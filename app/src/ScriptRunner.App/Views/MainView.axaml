<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScriptRunner.App.ViewModels"
             x:Class="ScriptRunner.App.Views.MainView"
             x:DataType="vm:MainViewModel"
             Focusable="True">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding StopCommand}" />
  </UserControl.KeyBindings>

  <UserControl.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
    <Style Selector="WrapPanel > :is(Control)">
      <Setter Property="Margin" Value="0,0,10,8" />
    </Style>
    <!-- The output keeps its dark colors when the pointer is over it or it has focus. -->
    <Style Selector="TextBox#OutputBox:pointerover, TextBox#OutputBox:focus">
      <Setter Property="Foreground" Value="#E6EDF3" />
    </Style>
    <Style Selector="TextBox#OutputBox:pointerover /template/ Border#PART_BorderElement, TextBox#OutputBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#10141B" />
    </Style>
  </UserControl.Styles>

  <DockPanel Margin="12">

    <!-- Connection -->
    <WrapPanel DockPanel.Dock="Top">
      <ComboBox ItemsSource="{Binding Modes}" SelectedIndex="{Binding SelectedModeIndex}"
                AutomationProperties.Name="Connection type" MinWidth="250" />
      <TextBox Text="{Binding Host}" PlaceholderText="Pi IP address" Width="160"
               AutomationProperties.Name="Pi IP address" />
      <TextBox Text="{Binding Port}" PlaceholderText="Port" Width="72" AutomationProperties.Name="Port" />
      <TextBox Text="{Binding User}" PlaceholderText="User" Width="100" IsVisible="{Binding IsSsh}"
               AutomationProperties.Name="User name" />
      <TextBox Text="{Binding Secret}" PlaceholderText="{Binding SecretLabel}" PasswordChar="•" Width="150"
               AutomationProperties.Name="{Binding SecretLabel}" />
      <CheckBox IsChecked="{Binding RememberSecret}" IsVisible="{Binding CanRememberSecret}"
                Content="Remember (secure storage)" />
      <Button Content="Forget saved SSH key" Command="{Binding ForgetHostKeyCommand}" IsVisible="{Binding IsSsh}" />
      <ToggleButton Content="Settings" IsChecked="{Binding IsSettingsOpen}" />
    </WrapPanel>

    <!-- Settings page: limits, each saved as it is changed. It takes the place of the rest of the screen while open. -->
    <ScrollViewer DockPanel.Dock="Top" IsVisible="{Binding IsSettingsOpen}" HorizontalScrollBarVisibility="Disabled">
    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,8,0,0">
      <StackPanel Spacing="6">
        <TextBlock Text="Settings" FontWeight="SemiBold" FontSize="16" />
        <Grid ColumnDefinitions="Auto,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="10">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Time limit per run (s)" VerticalAlignment="Center" />
          <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TimeLimitSeconds}" Width="110"
                   AutomationProperties.Name="Time limit per run in seconds" />
          <TextBlock Grid.Row="0" Grid.Column="2" Text="A run is stopped automatically after this long; 0 means no limit"
                     VerticalAlignment="Center" Opacity="0.75" TextWrapping="Wrap" />

          <TextBlock Grid.Row="1" Grid.Column="0" Text="Files kept beside the output" VerticalAlignment="Center" />
          <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ShownFilesKeptText}" Width="110"
                   AutomationProperties.Name="Files kept beside the output" />
          <TextBlock Grid.Row="1" Grid.Column="2" Text="Images and files from show(); the oldest is dropped past this"
                     VerticalAlignment="Center" Opacity="0.75" TextWrapping="Wrap" />

          <TextBlock Grid.Row="2" Grid.Column="0" Text="Largest file (MB)" VerticalAlignment="Center" />
          <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding LargestFileMegabytesText}" Width="110"
                   AutomationProperties.Name="Largest file in megabytes" />
          <TextBlock Grid.Row="2" Grid.Column="2" Text="Larger files from show() and play() are not downloaded"
                     VerticalAlignment="Center" Opacity="0.75" TextWrapping="Wrap" />

          <TextBlock Grid.Row="3" Grid.Column="0" Text="Output kept (characters)" VerticalAlignment="Center" />
          <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding OutputCharactersKeptText}" Width="110"
                   AutomationProperties.Name="Output kept in characters" />
          <TextBlock Grid.Row="3" Grid.Column="2" Text="Older output is dropped past this"
                     VerticalAlignment="Center" Opacity="0.75" TextWrapping="Wrap" />

          <TextBlock Grid.Row="4" Grid.Column="0" Text="Pi command time limit (s)" VerticalAlignment="Center" />
          <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding PiCommandSecondsText}" Width="110"
                   AutomationProperties.Name="Pi command time limit in seconds" />
          <TextBlock Grid.Row="4" Grid.Column="2" Text="Longest a command in the Pi command box may run (SSH mode)"
                     VerticalAlignment="Center" Opacity="0.75" TextWrapping="Wrap" />

          <TextBlock Grid.Row="5" Grid.Column="0" Text="Local Python" VerticalAlignment="Center" />
          <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding LocalPythonText}" Width="110" PlaceholderText="automatic"
                   AutomationProperties.Name="Local Python" />
          <TextBlock Grid.Row="5" Grid.Column="2" VerticalAlignment="Center" Opacity="0.75" TextWrapping="Wrap"
                     Text="Python that runs local files, for example one with Ultralytics installed; blank finds one" />

          <TextBlock Grid.Row="6" Grid.Column="0" Text="Local load time limit (s)" VerticalAlignment="Center" />
          <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding LocalLoadSecondsText}" Width="110"
                   AutomationProperties.Name="Local load time limit in seconds" />
          <TextBlock Grid.Row="6" Grid.Column="2" Text="Longest the local files may take to load when a run starts"
                     VerticalAlignment="Center" Opacity="0.75" TextWrapping="Wrap" />

          <TextBlock Grid.Row="7" Grid.Column="0" Text="Local call time limit (s)" VerticalAlignment="Center" />
          <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding LocalCallSecondsText}" Width="110"
                   AutomationProperties.Name="Local call time limit in seconds" />
          <TextBlock Grid.Row="7" Grid.Column="2" Text="Longest one remote_execute() call may take on the laptop"
                     VerticalAlignment="Center" Opacity="0.75" TextWrapping="Wrap" />
        </Grid>
        <TextBlock Text="Diagnostics" FontWeight="SemiBold" Margin="0,8,0,0" />
        <TextBlock TextWrapping="Wrap" Opacity="0.75"
                   Text="The app keeps a log of what it does (never passwords, PINs, or script output) and saves a report when something unexpected goes wrong. Send the report with a description of what happened." />
        <SelectableTextBlock Text="{Binding LogsFolder}" FontFamily="Consolas, Menlo, monospace" TextWrapping="Wrap" />
        <WrapPanel>
          <Button Content="Open logs folder" Click="OnOpenLogsFolder" IsVisible="{Binding CanOpenLogsFolder}" />
          <Button Content="Copy latest report" Click="OnCopyLatestReport"
                  ToolTip.Tip="Copies the newest crash report, or today's log if there is none, for pasting into an email" />
        </WrapPanel>
        <TextBlock Text="{Binding SettingsError}" Foreground="#C62828" TextWrapping="Wrap"
                   IsVisible="{Binding SettingsError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <WrapPanel>
          <Button Content="Restore defaults" Command="{Binding ResetSettingsCommand}" />
          <Button Content="Done" Command="{Binding ToggleSettingsCommand}" />
        </WrapPanel>
      </StackPanel>
    </Border>
    </ScrollViewer>

    <!-- The rest of the screen, hidden while Settings is open -->
    <DockPanel IsVisible="{Binding !IsSettingsOpen}">

    <!-- Files -->
    <Border DockPanel.Dock="Top" Name="DropArea" BorderBrush="Gray" BorderThickness="1" CornerRadius="6"
            Padding="10" Margin="0,0,0,8" DragDrop.AllowDrop="True">
      <StackPanel Spacing="6">
        <WrapPanel>
          <Button Content="Add files…" Click="OnAddFiles" />
          <TextBlock Classes="label" Text="or drop your .py file and any sound or image files here." />
        </WrapPanel>
        <ItemsControl ItemsSource="{Binding Files}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:FileEntry">
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                <CheckBox IsChecked="{Binding IsLocal}" Content="Local"
                          ToolTip.Tip="Keep this file on this computer: Local .py files run here, and the robot's script calls their functions with remote_execute()" />
                <Button Content="Remove" Padding="6,2"
                        Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).RemoveFileCommand}"
                        CommandParameter="{Binding}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding Scripts.Count}">
          <TextBlock Classes="label" Text="Run:" />
          <ComboBox ItemsSource="{Binding Scripts}" SelectedItem="{Binding SelectedScript}" MinWidth="200"
                    AutomationProperties.Name="Script to run" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Run controls -->
    <WrapPanel DockPanel.Dock="Top">
      <Button Content="Run" Classes="accent" Command="{Binding RunCommand}" IsEnabled="{Binding CanRun}" MinWidth="80" />
      <Button Content="Stop (Esc)" Command="{Binding StopCommand}" IsEnabled="{Binding IsRunning}" MinWidth="90" />
      <Button Content="Disconnect" Command="{Binding DisconnectCommand}" IsEnabled="{Binding IsConnected}"
              ToolTip.Tip="Close the connection to the Pi (a running script is stopped first)" />
      <Button Content="Clear output" Command="{Binding ClearCommand}" />
      <CheckBox IsChecked="{Binding SpeakSay}" Content="Speak say() messages" />
      <CheckBox IsChecked="{Binding SpeakAll}" Content="Speak all output" />
    </WrapPanel>

    <!-- Commands on the Pi (SSH only): each runs on its own connection, so it works even if a script is stuck. -->
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" IsVisible="{Binding IsSsh}">
      <Button DockPanel.Dock="Right" Content="Force stop all Python" Command="{Binding ForceStopCommand}"
              IsEnabled="{Binding CanSendPiCommand}" Margin="8,0,0,0"
              ToolTip.Tip="Ctrl+C to every Python program you started on the Pi, then force-quit after 2 seconds" />
      <Button DockPanel.Dock="Right" Content="Run on Pi" Command="{Binding RunPiCommandCommand}"
              IsEnabled="{Binding CanSendPiCommand}" Margin="8,0,0,0" />
      <TextBox Text="{Binding PiCommandText}" PlaceholderText="Command to run on the Pi, for example: ps aux | grep python3"
               FontFamily="Consolas, Menlo, monospace" AutomationProperties.Name="Command to run on the Pi">
        <TextBox.KeyBindings>
          <KeyBinding Gesture="Enter" Command="{Binding RunPiCommandCommand}" />
        </TextBox.KeyBindings>
      </TextBox>
    </DockPanel>

    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" />
      <TextBlock Text="{Binding ErrorText}" Foreground="#C62828" TextWrapping="Wrap" FontWeight="SemiBold" />
    </StackPanel>

    <!-- Input -->
    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
      <Button DockPanel.Dock="Right" Content="Send" Command="{Binding SendCommand}" IsEnabled="{Binding IsRunning}" Margin="8,0,0,0" />
      <TextBox Name="InputBox" Text="{Binding InputText}" IsEnabled="{Binding IsRunning}"
               PlaceholderText="Type input for your program, then press Enter"
               FontFamily="Consolas, Menlo, monospace" AutomationProperties.Name="Program input">
        <TextBox.KeyBindings>
          <KeyBinding Gesture="Enter" Command="{Binding SendCommand}" />
        </TextBox.KeyBindings>
      </TextBox>
    </DockPanel>

    <!-- Output and images -->
    <Grid ColumnDefinitions="*,Auto" ClipToBounds="True">
      <TextBox Name="OutputBox" Grid.Column="0" Text="{Binding OutputText}" IsReadOnly="True"
               AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas, Menlo, monospace"
               Background="#10141B" Foreground="#E6EDF3"
               ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Program output" />
      <!-- Files the script showed, one at a time, newest shown when it arrives: pictures as pictures, other files
           as a card with their name, size, and (for text files) their first lines -->
      <Grid Grid.Column="1" Margin="8,0,0,0" Width="360" RowDefinitions="*,Auto,Auto,Auto" IsVisible="{Binding HasShownFiles}">
        <Image Grid.Row="0" Source="{Binding CurrentImage}" Stretch="Uniform" StretchDirection="DownOnly"
               VerticalAlignment="Top" AutomationProperties.Name="{Binding CurrentShownName}"
               IsVisible="{Binding !IsCurrentCard}" />
        <Border Grid.Row="0" IsVisible="{Binding IsCurrentCard}" BorderBrush="Gray" BorderThickness="1"
                CornerRadius="6" Padding="10" VerticalAlignment="Top">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding CurrentShownName, StringFormat='📄 {0}'}" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding CurrentShownNote}" Opacity="0.75" />
            <ScrollViewer MaxHeight="360" HorizontalScrollBarVisibility="Auto"
                          IsVisible="{Binding CurrentPreview, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock Text="{Binding CurrentPreview}" FontFamily="Consolas, Menlo, monospace" FontSize="12"
                         AutomationProperties.Name="Preview" />
            </ScrollViewer>
          </StackPanel>
        </Border>
        <TextBlock Grid.Row="1" Margin="0,4,0,0" Text="{Binding CurrentShownName}" HorizontalAlignment="Center"
                   TextTrimming="CharacterEllipsis" IsVisible="{Binding !IsCurrentCard}" />
        <Grid Grid.Row="2" Margin="0,4,0,0" ColumnDefinitions="Auto,*,Auto">
          <Button Grid.Column="0" Content="◀" Command="{Binding PreviousShownCommand}"
                  IsEnabled="{Binding CanShowPrevious}" ToolTip.Tip="Previous file"
                  AutomationProperties.Name="Previous file" />
          <TextBlock Grid.Column="1" Text="{Binding ShownPosition}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Button Grid.Column="2" Content="▶" Command="{Binding NextShownCommand}"
                  IsEnabled="{Binding CanShowNext}" ToolTip.Tip="Next file"
                  AutomationProperties.Name="Next file" />
        </Grid>
        <WrapPanel Grid.Row="3" Margin="0,4,0,0" HorizontalAlignment="Center">
          <Button Content="Save…" Click="OnSaveShown" ToolTip.Tip="Save this file" />
          <Button Content="Save all…" Click="OnSaveAllShown" ToolTip.Tip="Save every file to a folder" />
          <Button Content="Clear all" Command="{Binding ClearShownCommand}" ToolTip.Tip="Remove every file from this panel" />
        </WrapPanel>
      </Grid>
    </Grid>
    </DockPanel>
  </DockPanel>
</UserControl>
