<Project Sdk="Microsoft.NET.Sdk">

  <!-- The SSH connection to a Raspberry Pi and the output parser.
       No user interface code, so the desktop and Android apps and the tests all share it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ScriptRunner.Core</RootNamespace>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SSH.NET" Version="$(SshNetVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- SSH mode uploads these next to the user's script. runner_io.py is the same file the Pi server uses. -->
    <EmbeddedResource Include="..\..\..\runner\runner_io.py" LogicalName="runner_io.py" />
    <EmbeddedResource Include="Remote\_script_runner_shim.py" LogicalName="_script_runner_shim.py" />
    <!-- Runs on this computer to call the user's local functions (runner_io.remote_execute). -->
    <EmbeddedResource Include="Remote\_local_host.py" LogicalName="_local_host.py" />
    <!-- Run on the Pi by the app's "Check robot" button. -->
    <EmbeddedResource Include="Remote\robot_check.py" LogicalName="robot_check.py" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ScriptRunner.Tests" />
  </ItemGroup>

</Project>
