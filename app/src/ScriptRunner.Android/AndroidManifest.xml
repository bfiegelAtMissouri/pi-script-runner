<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" android:installLocation="auto">
  <uses-permission android:name="android.permission.INTERNET" />
  <!-- The app reaches the Pi over SSH, which is encrypted, so plain HTTP stays blocked. allowBackup is off so
       remembered passwords stay on this device. -->
  <application android:label="Script Runner" android:icon="@drawable/icon" android:allowBackup="false"
               android:usesCleartextTraffic="false" />
</manifest>
