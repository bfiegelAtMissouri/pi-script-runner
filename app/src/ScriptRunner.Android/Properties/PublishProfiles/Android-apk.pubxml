<?xml version="1.0" encoding="utf-8"?>
<!-- Signed Android app (APK) in publish/android/. See docs/app.md for the one-time keystore setup. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <PublishDir>../../publish/android/</PublishDir>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <!-- Sign with the release keystore (kept out of git). The password comes from the environment variable
         SCRIPTRUNNER_KEYSTORE_PASSWORD, so it is never stored in a file. -->
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>$(MSBuildProjectDirectory)/../../scriptrunner-release.keystore</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>scriptrunner</AndroidSigningKeyAlias>
    <AndroidSigningStorePass>env:SCRIPTRUNNER_KEYSTORE_PASSWORD</AndroidSigningStorePass>
    <AndroidSigningKeyPass>env:SCRIPTRUNNER_KEYSTORE_PASSWORD</AndroidSigningKeyPass>
  </PropertyGroup>
</Project>
